  "repository": "zenjoy/nimbu-toolbelt",
  "scripts": {
    "build": "rm -rf lib node_modules/.cache && rm -f tsconfig.tsbuildinfo && tsc -b",
    "lint": "eslint . --ext .ts --config .eslintrc",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "pnpm run build",
    "pretest": "tsc -p test --noEmit",
    "test": "mocha --forbid-only 'test/**/*.test.ts' --timeout 60000",
    "posttest": "pnpm run lint",
    "yalc:publish": "pnpm run build && pnpm exec yalc publish --push --no-script"
  }
}
