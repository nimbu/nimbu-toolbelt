{
  "name": "nimbu",
  "description": "Tools for Nimbu projects",
  "version": "6.0.0-alpha.0",
  "author": "Zenjoy Engineering",
  "bin": "./bin/run",
  "bugs": "https://github.com/zenjoy/nimbu-toolbelt/issues",
  "dependencies": {
    "@nimbu-cli/command": "workspace:^6.0.0-alpha.0",
    "@oclif/core": "^4.5.4",
    "@oclif/plugin-autocomplete": "^3.2.35",
    "@oclif/plugin-commands": "^4.1.34",
    "@oclif/plugin-help": "^6.2.33",
    "@oclif/plugin-not-found": "^3.2.68",
    "@oclif/plugin-plugins": "^5.4.49",
    "@oclif/plugin-update": "^4.7.8",
    "@oclif/plugin-version": "^2.2.33",
    "@oclif/plugin-warn-if-update-available": "^3.1.48",
    "@oclif/plugin-which": "^3.2.40",
    "chalk": "^4.1.2",
    "date-fns": "^2.30.0",
    "debug": "^4.4.3",
    "deep-object-diff": "^1.1.9",
    "dependency-graph": "^0.11.0",
    "diff": "^8.0.2",
    "fast-glob": "^3.3.3",
    "follow-redirects": "^1.15.11",
    "front-matter": "^3.2.1",
    "fs-extra": "^11.3.2",
    "fuzzy": "^0.1.3",
    "hyperlinker": "^1.0.0",
    "ignore": "^5.3.2",
    "inquirer": "^8.2.7",
    "inquirer-autocomplete-prompt": "^1.4.0",
    "js-yaml": "^3.14.1",
    "listr2": "^9.0.4",
    "lodash": "^4.17.21",
    "log-symbols": "^3.0.0",
    "open": "^10.2.0",
    "pretty-bytes": "^5.6.0",
    "rxjs": "^6.6.7",
    "supports-hyperlinks": "^1.0.1",
    "through": "^2.3.8",
    "tmp-promise": "^3.0.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.14",
    "@types/chai": "^4.3.20",
    "@types/debug": "^4.1.12",
    "@types/follow-redirects": "^1.14.4",
    "@types/mocha": "^10.0.10",
    "@types/mock-fs": "^4.13.4",
    "chai": "^4.5.0",
    "mocha": "^11.7.4",
    "mock-fs": "^4.14.0",
    "nock": "^14.0.10",
    "sinon": "^19.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/oclif.manifest.json",
    "/polyfills.js",
    "/README.md"
  ],
  "homepage": "https://github.com/zenjoy/nimbu-toolbelt",
  "keywords": [
    "oclif",
    "nimbu",
    "nimbu-cli"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "nimbu",
    "dirname": "nimbu",
    "scope": "nimbu-cli",
    "npmRegistry": "https://registry.npmjs.org",
    "plugins": [
      "@oclif/plugin-commands",
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-plugins",
      "@oclif/plugin-update",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-which",
      "@oclif/plugin-autocomplete"
    ],
    "optionalPlugins": [
      "@nimbu-cli/plugin-webpack-v5",
      "@nimbu-cli/plugin-vite"
    ],
    "hooks": {
      "init": "./lib/hooks/optional-plugins"
    },
    "topics": {
      "auth": {
        "description": "authenticate, display token and current user"
      },
      "init": {
        "description": "working directory initialization"
      },
      "sites": {
        "description": "interacting with your sites (list, create)"
      },
      "themes": {
        "description": "working with themes (upload / download)"
      },
      "browse": {
        "description": "open the current site in your browser (simulator, admin)"
      },
      "apps": {
        "description": "manage (cloud code) applications"
      },
      "mails": {
        "description": "manage your notification templates"
      },
      "channels": {
        "description": "working with channels"
      },
      "products": {
        "description": "working with products"
      },
      "customers": {
        "description": "working with customers"
      },
      "notifications": {
        "description": "working with notifications"
      },
      "translations": {
        "description": "working with translations"
      }
    },
    "topicSeparator": ":",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "repository": "zenjoy/nimbu-toolbelt",
  "scripts": {
    "lint": "eslint .",
    "build": "rm -rf lib node_modules/.cache && rm -f tsconfig.tsbuildinfo && tsc",
    "postpublish": "rm -f oclif.manifest.json",
    "prepack": "pnpm run build && pnpm exec oclif manifest",
    "pretest": "tsc -p test --noEmit",
    "test": "mocha --forbid-only 'test/**/*.test.ts' --timeout 60000",
    "posttest": "pnpm run lint",
    "version": "oclif readme --multi && git add README.md",
    "yalc:publish": "pnpm run build && pnpm exec oclif manifest && pnpm dlx yalc publish --push --no-script"
  },
  "types": "lib/index.d.ts",
  "mocha": {
    "diff": true,
    "recursive": true,
    "extension": [
      "ts"
    ],
    "require": [
      "test/helpers/init.js",
      "ts-node/register/transpile-only"
    ],
    "watchExtensions": [
      "ts"
    ],
    "package": "./package.json",
    "reporter": "spec",
    "slow": 75,
    "timeout": 60000,
    "ui": "bdd"
  },
  "gitHead": "a2f1ff0a3c6f51da4b5a910649d5b0b7f6af7d41"
}
