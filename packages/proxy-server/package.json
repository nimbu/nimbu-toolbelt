{
  "name": "@nimbu-cli/proxy-server",
  "version": "6.0.0",
  "description": "HTTP proxy server for Nimbu CLI development",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "rm -rf lib node_modules/.cache && rm -f tsconfig.tsbuildinfo && tsc -b",
    "clean": "rimraf lib",
    "prepack": "pnpm run build",
    "test": "mocha --require ts-node/register 'test/**/*.test.ts'",
    "lint": "eslint src --ext .ts",
    "yalc:publish": "pnpm run build && pnpm exec yalc publish --push --no-script"
  },
  "dependencies": {
    "@nimbu-cli/command": "workspace:^6.0.0",
    "axios": "^1.12.2",
    "chalk": "^4.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "multer": "^2.0.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.7.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "nock": "^14.0.10",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "engines": {
    "node": ">=14.18.0"
  },
  "license": "MIT"
}
